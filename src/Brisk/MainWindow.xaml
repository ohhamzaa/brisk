<Window x:Class="Brisk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Brisk.ViewModels"
        xmlns:views="clr-namespace:Brisk.Views"
        xmlns:c="clr-namespace:Brisk.Controls"
        Title="Brisk" Width="1120" Height="790" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/brisk.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><views:MemoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><views:CleanupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnoseViewModel}"><views:DiagnoseView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoostViewModel}"><views:BoostView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== sidebar ===== -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,12">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#090B0C" BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1">
                        <Path Style="{StaticResource PulseLine}" StrokeThickness="2" Margin="6,8" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="Brisk" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="PC performance" Style="{StaticResource Label}" FontWeight="Normal" FontSize="10.5" Margin="0,-1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <!-- black-box status -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,11" Margin="0,0,0,10" Cursor="Hand" DataContext="{Binding History}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="History" />
                        </Border.InputBindings>
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
                                <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.2" Opacity="0" c:Loop.Kind="ripple"
                                         Visibility="{Binding RecordInBackground, Converter={StaticResource Visible}}" />
                                <Ellipse Width="8" Height="8">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecordInBackground}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <StackPanel>
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Recording is off" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecordInBackground}" Value="True">
                                                    <Setter Property="Text" Value="Watching for lag" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DockPanel Margin="4,0,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Style="{StaticResource Label}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Style="{StaticResource GhostButton}" BorderThickness="0" Padding="6,4" HorizontalAlignment="Left"
                                Command="{Binding RestartAsAdminCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource Hidden}}"
                                ToolTip="Some cleanups, all-user startup apps and clearing the standby cache need admin.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="Run as admin" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextDimBrush}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource Visible}}" Margin="6,0,0,0">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="Admin" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="Overview" Tag="&#xE80F;" Margin="0,8,0,2"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard}" />
                    <TextBlock Text="FIX IT" Style="{StaticResource NavSection}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Why so slow?" Tag="&#xE9D9;"
                                 Command="{Binding NavigateCommand}" CommandParameter="Diagnose"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Diagnose}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Game boost" Tag="&#xE7FC;"
                                 Command="{Binding NavigateCommand}" CommandParameter="Boost"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Boost}" />
                    <TextBlock Text="CLEAN UP" Style="{StaticResource NavSection}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Memory" Tag="&#xE964;"
                                 Command="{Binding NavigateCommand}" CommandParameter="Memory"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Memory}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Startup apps" Tag="&#xE7B5;"
                                 Command="{Binding NavigateCommand}" CommandParameter="Startup"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Startup}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Cleanup" Tag="&#xE74D;"
                                 Command="{Binding NavigateCommand}" CommandParameter="Cleanup"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Cleanup}" />
                    <TextBlock Text="HISTORY" Style="{StaticResource NavSection}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Lag history" Tag="&#xE81C;"
                                 Command="{Binding NavigateCommand}" CommandParameter="History"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=History}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            </StackPanel>

            <c:AnimatedContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False" />
        </Grid>

        <!-- ===== toast ===== -->
        <Border Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="220,0,0,26"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="9" Padding="16,11" MaxWidth="560" c:Anim.Delay="0"
                Visibility="{Binding Toast, Converter={StaticResource Visible}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Toast}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="500" />
            </StackPanel>
        </Border>

        <!-- ===== first-run welcome ===== -->
        <Grid Grid.ColumnSpan="2" Background="#D9070809" Visibility="{Binding Welcome, Converter={StaticResource Visible}}">
            <Border Width="560" Style="{StaticResource Card}" Padding="34,30" Background="{StaticResource SurfaceBrush}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" DataContext="{Binding Welcome}" c:Anim.Pop="True">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="14" Background="#090B0C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <Path Style="{StaticResource PulseLine}" c:Loop.Kind="heartbeat" StrokeThickness="2.4" Margin="11,15" />
                    </Border>
                    <TextBlock Text="Welcome to Brisk" Style="{StaticResource H1}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="13.5" Margin="0,6,0,22"
                               Text="Brisk tells you exactly why your PC is slow, and remembers every freeze so you're never left guessing. Pick how it should work:" />

                    <DockPanel Margin="0,0,0,14">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Record}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Record slowdowns in the background" Style="{StaticResource H2}" FontSize="13.5" />
                            <TextBlock Text="Stays in the tray when closed. Uses about 0.1% CPU." Style="{StaticResource Dim}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource H2}" FontSize="13.5" />
                            <TextBlock Text="So the black box is always on, even if you forget to open Brisk." Style="{StaticResource Dim}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Notify}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Alert me when my PC struggles" Style="{StaticResource H2}" FontSize="13.5" />
                            <TextBlock Text="A quiet notification naming the cause, at most every 10 minutes." Style="{StaticResource Dim}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,26">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding NetworkChecks}" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Watch network lag" Style="{StaticResource H2}" FontSize="13.5" />
                            <TextBlock Text="Pings your router and 1.1.1.1. That's the only network traffic Brisk ever sends." Style="{StaticResource Dim}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Just look around" Style="{StaticResource BaseButton}" Command="{Binding DoneCommand}" Margin="0,0,8,0"
                                AutomationProperties.Name="Just look around" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding DiagnoseCommand}" AutomationProperties.Name="Check my PC now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Check my PC now" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== confirm dialog ===== -->
        <Grid Grid.ColumnSpan="2" Background="#B3000000"
              Visibility="{Binding Confirm, Converter={StaticResource Visible}}">
            <Border Width="420" Style="{StaticResource Card}" Padding="24" Background="{StaticResource Surface2Brush}" c:Anim.Pop="True"
                    VerticalAlignment="Center" HorizontalAlignment="Center" DataContext="{Binding Confirm}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" FontSize="13" Margin="0,8,0,22" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource BaseButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                IsCancel="True" />
                        <Button Content="{Binding OkText}" Command="{Binding OkCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Danger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="#1A0807" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
