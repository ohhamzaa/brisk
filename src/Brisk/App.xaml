<Application x:Class="Brisk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Brisk"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:EnumEqualsConverter x:Key="EnumEquals" />
            <local:BoolToVisibilityConverter x:Key="Visible" />
            <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <local:LevelToBrushConverter x:Key="LevelBrush" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:PercentConverter x:Key="Percent" />
            <local:FractionConverter x:Key="Fraction" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
