<UserControl x:Class="Brisk.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,0,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BaseButton}" AutomationProperties.Name="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Clean" Command="{Binding CleanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Clean" />
                        <TextBlock Text="{Binding TotalText}" Margin="6,0,0,0"
                                   Visibility="{Binding TotalText, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Cleanup" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="12,12" CornerRadius="8" Margin="0,1" Background="Transparent">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding Selected}"
                                              VerticalAlignment="Center" Margin="0,0,16,0"
                                              IsEnabled="{Binding Locked, Converter={StaticResource InverseBool}}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="16,0,4,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
