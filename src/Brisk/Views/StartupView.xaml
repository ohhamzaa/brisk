<UserControl x:Class="Brisk.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,0,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" AutomationProperties.Name="Refresh" Command="{Binding ReloadCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Startup apps" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource InfoBrush}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource Dim}"
                           Text="Turning an app off only stops it launching at sign-in. Nothing is uninstalled, and you can switch it back on any time. Task Manager shows the same settings." />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="6">
            <ListBox ItemsSource="{Binding Entries}" Style="{StaticResource RowList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                      VerticalAlignment="Center" Margin="16,0,4,0" />
                            <Grid DockPanel.Dock="Left" Width="34">
                                <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource TextFaintBrush}"
                                           Visibility="{Binding Icon, Converter={StaticResource Hidden}}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="13.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Command}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
