<UserControl x:Class="Brisk.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Brisk.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
        <StackPanel>
            <!-- header -->
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BaseButton}" AutomationProperties.Name="Scan junk" Command="{Binding QuickCleanCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Scan junk" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Free up RAM" Command="{Binding FreeRamCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Free up RAM" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0">
                        <Run Text="{Binding OsName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CpuName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- hero: the twist -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12" BorderBrush="#24452F" c:Anim.Delay="0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding DiagnoseCommand}"
                            VerticalAlignment="Center" AutomationProperties.Name="Diagnose now">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Diagnose now" />
                        </StackPanel>
                    </Button>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentDimBrush}" Margin="0,0,14,0">
                        <Path Style="{StaticResource PulseLine}" c:Loop.Kind="heartbeat" StrokeThickness="2" Margin="8,11" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="PC feeling slow? Find out exactly why in 10 seconds." Style="{StaticResource H2}" FontSize="14.5" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0"
                                   Text="Names the app or Windows task that's responsible, in plain English, with a one-click fix."
                                   Visibility="{Binding LastLag, Converter={StaticResource Hidden}}" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Visibility="{Binding LastLag, Converter={StaticResource Visible}}">
                            <Hyperlink Command="{Binding OpenHistoryCommand}" Foreground="{StaticResource TextDimBrush}" TextDecorations="None">
                                <Run Text="{Binding LastLag, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- gauges -->
            <UniformGrid Columns="3" Margin="-6,0">
                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="6,0" c:Anim.Delay="60">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CoresText}" Style="{StaticResource Label}" FontWeight="Normal" />
                            <TextBlock Text="PROCESSOR" Style="{StaticResource Label}" />
                        </DockPanel>
                        <Grid Margin="0,16,0,0">
                            <c:RingGauge Width="92" Height="92" Thickness="8" Value="{Binding Cpu}" HorizontalAlignment="Left"
                                         TrackBrush="{StaticResource Surface2Brush}" FillBrush="{StaticResource AccentBrush}"
                                         WarnBrush="{StaticResource WarnBrush}" DangerBrush="{StaticResource DangerBrush}" />
                            <StackPanel Orientation="Horizontal" Width="92" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource BigNumber}" FontSize="24" Width="92"
                                           TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="110,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H2}" FontSize="16">
                                    <Run Text="{Binding ProcessCount, Mode=OneWay}" /><Run Text=" processes" FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                                </TextBlock>
                                <TextBlock Text="Busiest app" Style="{StaticResource Dim}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding TopCpu}" Foreground="{StaticResource TextBrush}" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <c:Sparkline Height="44" Margin="0,16,0,0" Values="{Binding CpuHistory}" Stroke="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" Margin="6,0" c:Anim.Delay="110">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamTotal}" Style="{StaticResource Label}" FontWeight="Normal" />
                            <TextBlock Text="MEMORY" Style="{StaticResource Label}" />
                        </DockPanel>
                        <Grid Margin="0,16,0,0">
                            <c:RingGauge Width="92" Height="92" Thickness="8" Value="{Binding Ram}" HorizontalAlignment="Left"
                                         TrackBrush="{StaticResource Surface2Brush}" FillBrush="{StaticResource InfoBrush}"
                                         WarnBrush="{StaticResource WarnBrush}" DangerBrush="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding RamText}" Style="{StaticResource BigNumber}" FontSize="24" Width="92"
                                       TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Margin="110,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RamDetail}" Style="{StaticResource H2}" FontSize="16" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0">
                                    <Run Text="Available " /><Run Text="{Binding RamAvailable, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Dim}"
                                           ToolTip="Windows keeps recently used files in spare RAM to make them open faster. It's given back instantly when an app needs it.">
                                    <Run Text="Cached " /><Run Text="{Binding RamCached, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <c:Sparkline Height="44" Margin="0,16,0,0" Values="{Binding RamHistory}" Stroke="{StaticResource InfoBrush}" />
                    </StackPanel>
                </Border>

                <!-- Disk + uptime -->
                <Border Style="{StaticResource Card}" Margin="6,0" c:Anim.Delay="160">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DiskName}" Style="{StaticResource Label}" FontWeight="Normal" />
                            <TextBlock Text="STORAGE" Style="{StaticResource Label}" />
                        </DockPanel>
                        <Grid Margin="0,16,0,0">
                            <c:RingGauge Width="92" Height="92" Thickness="8" Value="{Binding Disk}" HorizontalAlignment="Left"
                                         TrackBrush="{StaticResource Surface2Brush}" FillBrush="{StaticResource AccentBrush}"
                                         WarnBrush="{StaticResource WarnBrush}" DangerBrush="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding Disk, StringFormat={}{0:0}}" Style="{StaticResource BigNumber}" FontSize="24" Width="92"
                                       TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Margin="110,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DiskText}" Style="{StaticResource H2}" FontSize="16" />
                                <TextBlock Text="{Binding DiskTotal}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0" Height="44">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Uptime}" Style="{StaticResource H2}" FontSize="13" />
                                <TextBlock Text="On since last restart" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- tips + top apps -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" c:Anim.Delay="220">
                    <StackPanel>
                        <TextBlock Text="RECOMMENDATIONS" Style="{StaticResource Label}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Tips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,12,2"
                                                    Background="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                            <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Command="{Binding Action}"
                                                    Style="{StaticResource RowButton}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Visibility="{Binding ActionText, Converter={StaticResource Visible}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="13" />
                                                <TextBlock Text="{Binding Body}" Style="{StaticResource Dim}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" c:Anim.Delay="260">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="See all" Style="{StaticResource GhostButton}" FontSize="12"
                                    Padding="8,3" BorderThickness="0" Foreground="{StaticResource TextDimBrush}"
                                    Command="{Binding OpenMemoryCommand}" />
                            <TextBlock Text="TOP MEMORY USERS" Style="{StaticResource Label}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource TextFaintBrush}"
                                                   Visibility="{Binding Icon, Converter={StaticResource Hidden}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Height="3" CornerRadius="2" Background="{StaticResource Surface2Brush}" Margin="0,5,12,0">
                                                <Border CornerRadius="2" Background="{StaticResource InfoBrush}" HorizontalAlignment="Stretch"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Share}" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- power plan -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" c:Anim.Delay="300">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="260" Margin="0,0,20,0">
                        <TextBlock Text="POWER PLAN" Style="{StaticResource Label}" />
                        <TextBlock Text="High performance keeps the CPU at full speed. Balanced saves power when idle."
                                   Style="{StaticResource Dim}" Margin="0,6,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding ActivePlan}" Background="Transparent"
                             BorderThickness="0" ItemContainerStyle="{StaticResource ChipItem}" VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
