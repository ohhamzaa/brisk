<UserControl x:Class="Brisk.Views.DiagnoseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Brisk.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
        <StackPanel>
            <TextBlock Text="Why is my PC slow?" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,22"
                       Text="Brisk watches your PC for 10 seconds, finds what's actually slowing it down, and gives you the fix." />

            <!-- ===== idle ===== -->
            <Border Style="{StaticResource Card}" Padding="40,44" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}" c:Anim.Delay="0">
                <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource Surface2Brush}" HorizontalAlignment="Center">
                        <Path Style="{StaticResource PulseLine}" c:Loop.Kind="heartbeat" StrokeThickness="2.4" Margin="14,18" />
                    </Border>
                    <TextBlock Text="Run it while your PC feels slow" Style="{StaticResource H2}" FontSize="18" Margin="0,20,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="13" TextAlignment="Center" Margin="0,8,0,24"
                               Text="It checks CPU, memory and swapping, disk activity and CPU speed, then names the app or Windows task responsible in plain English." />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" HorizontalAlignment="Center"
                            Padding="22,11" FontSize="14" AutomationProperties.Name="Start diagnosis">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="Start diagnosis" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== running ===== -->
            <Border Style="{StaticResource Card}" Padding="40,44" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" c:Anim.Pop="True">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <!-- sonar ripple -->
                        <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0" c:Loop.Kind="ripple" />
                        <c:RingGauge Thickness="7" Value="{Binding Progress, Converter={StaticResource Percent}}"
                                     TrackBrush="{StaticResource Surface2Brush}" FillBrush="{StaticResource AccentBrush}"
                                     WarnBrush="{StaticResource AccentBrush}" DangerBrush="{StaticResource AccentBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource PulseLine}" c:Loop.Kind="trace" StrokeThickness="2" Width="52" Height="22" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Countdown}" Style="{StaticResource BigNumber}" FontSize="22" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Watching your PC…" Style="{StaticResource H2}" FontSize="17" Margin="0,20,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Keep using it normally. Do whatever was feeling slow." Style="{StaticResource Dim}" FontSize="13"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Live}" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,16,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ===== done ===== -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card}" Padding="22,20" c:Anim.Delay="0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Command="{Binding StartCommand}"
                                VerticalAlignment="Center" AutomationProperties.Name="Run again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Run again" />
                            </StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0" VerticalAlignment="Top" c:Anim.Pop="True" c:Anim.Delay="150">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#3A2A12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Healthy}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Healthy}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding Verdict}" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Dim}" FontSize="13" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Label}" FontWeight="Normal" Margin="0,10,0,0" />
                            <Button Content="Open lag history" Style="{StaticResource RowButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding OpenHistoryCommand}" Visibility="{Binding Healthy, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0" c:Anim.Delay="180">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="10,0,0,10"
                                            Background="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                    <StackPanel Margin="20,18,20,18">
                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Label}"
                                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                        <TextBlock Text="{Binding Headline}" Style="{StaticResource H2}" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}" FontSize="13" Margin="0,6,0,0" />

                                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                                                Visibility="{Binding HasCulprit, Converter={StaticResource Visible}}">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" Width="32">
                                                    <Image Source="{Binding CulpritIcon}" Width="22" Height="22" HorizontalAlignment="Left"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource TextFaintBrush}"
                                                               Visibility="{Binding CulpritIcon, Converter={StaticResource Hidden}}" />
                                                </Grid>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CulpritStats}" Foreground="{StaticResource TextDimBrush}"
                                                           FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding CulpritName}" Foreground="{StaticResource TextBrush}" FontSize="13.5"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,14,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,8,0"
                                                            Style="{StaticResource BaseButton}" Padding="12,7" FontSize="12.5" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
