<UserControl x:Class="Brisk.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,0,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Command="{Binding ClearCommand}" VerticalAlignment="Center"
                    AutomationProperties.Name="Clear history">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Lag history" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- recorder settings -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RecordInBackground}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Record slowdowns in the background" Style="{StaticResource H2}" FontSize="13.5" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0"
                                   Text="When you close the window, Brisk stays in the tray and notes every freeze longer than 5 seconds and what caused it. Uses well under 1% CPU. Nothing leaves your PC." />
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Start Brisk with Windows" Style="{StaticResource H2}" FontSize="13.5" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0"
                                   Text="Starts quietly in the tray at sign-in, so lag gets recorded even if you forget to open it." />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="6">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No slowdowns recorded yet" Style="{StaticResource H2}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,6,0,0"
                               Text="When your PC freezes or stutters, it'll show up here with the app or Windows task that caused it. Then you'll know what happened instead of guessing." />
                </StackPanel>

                <ListBox ItemsSource="{Binding Events}" Style="{StaticResource RowList}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,2,14,2"
                                        Background="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                <StackPanel DockPanel.Dock="Left" Width="150" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding When}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Dim}" FontSize="12">
                                        <Run Text="{Binding Duration, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KindsText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Headline}" Foreground="{StaticResource TextBrush}" FontSize="13.5" TextWrapping="Wrap"
                                               ToolTip="{Binding Detail}" />
                                    <TextBlock Text="{Binding CulpritsText}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
