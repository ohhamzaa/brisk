<UserControl x:Class="Brisk.Views.BoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Brisk.Controls">
    <DockPanel Margin="32,0,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh games" Visibility="{Binding Inactive, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Game boost" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                           Text="Quiets everything else so your game gets the whole PC. Nothing is closed, and it all goes back to normal when the game exits." />
            </StackPanel>
        </DockPanel>

        <!-- ===== active ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="22,20" BorderBrush="#24452F" Margin="0,0,0,12"
                Visibility="{Binding Active, Converter={StaticResource Visible}}" c:Anim.Pop="True">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Command="{Binding StopCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="Stop boost" Content="Stop boost" />
                <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,18,0">
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0" c:Loop.Kind="ripple" />
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentDimBrush}">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource H2}" FontSize="18" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Dim}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== pick a game ===== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="{Binding Inactive, Converter={StaticResource Visible}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Padding="22,10"
                    AutomationProperties.Name="Boost">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Boost selected game" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Background apps go into Efficiency mode at lower priority, your game gets higher priority, idle memory is freed and the power plan goes to maximum." />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="6" Visibility="{Binding Inactive, Converter={StaticResource Visible}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Start your game, then come back here" Style="{StaticResource H2}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Brisk lists every open app with a window. The one using your graphics card most is picked for you." />
                </StackPanel>
                <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}" Style="{StaticResource RowList}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="40">
                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource TextFaintBrush}"
                                               Visibility="{Binding Icon, Converter={StaticResource Hidden}}" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" FontSize="11.5" Margin="0,1,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
