<UserControl x:Class="Brisk.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,0,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Free up RAM" Command="{Binding FreeRamCommand}" VerticalAlignment="Center"
                    ToolTip="Moves memory that background apps aren't actively using out of RAM. As admin, also clears the standby cache. Apps get it back the moment they need it.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Free up RAM" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Memory" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Height="36" Margin="0,0,0,12" Tag="Search apps"
                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />

        <!-- column header -->
        <Grid DockPanel.Dock="Top" Margin="19,0,27,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="APP" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="3" Text="CPU" Style="{StaticResource Label}" HorizontalAlignment="Right" />
        </Grid>

        <Border Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="List" ItemsSource="{Binding Apps}" Style="{StaticResource RowList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource TextFaintBrush}"
                                       Visibility="{Binding Icon, Converter={StaticResource Hidden}}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" FontSize="13.5"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Margin="0,1,0,0">
                                    <Run Text="{Binding Key, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CountText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MemoryText}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                <Border Grid.Column="1" Height="4" CornerRadius="2" Background="{StaticResource Surface2Brush}" VerticalAlignment="Center">
                                    <Border CornerRadius="2" Background="{StaticResource InfoBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Share}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Column="3" Text="{Binding CpuText}" Foreground="{StaticResource TextDimBrush}" FontSize="13"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Trim" Style="{StaticResource RowButton}" Margin="0,0,6,0"
                                        Command="{Binding DataContext.TrimCommand, ElementName=List}" CommandParameter="{Binding}"
                                        ToolTip="Push this app's idle memory out of RAM" />
                                <Button Content="End task" Style="{StaticResource RowButton}"
                                        Command="{Binding DataContext.EndTaskCommand, ElementName=List}" CommandParameter="{Binding}"
                                        Visibility="{Binding IsProtected, Converter={StaticResource Hidden}}" />
                                <TextBlock Text="System" Style="{StaticResource Label}" FontWeight="Normal" VerticalAlignment="Center"
                                           Margin="8,0,6,0" Visibility="{Binding IsProtected, Converter={StaticResource Visible}}"
                                           ToolTip="Windows needs this to run, so Brisk won't end it." />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
